@@ -606,6 +606,12 @@ static const struct dmi_system_id orient
 		  DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "ONEXPLAYER G1 i"),
 		},
 		.driver_data = (void *)&lcd1600x2560_leftside_up,

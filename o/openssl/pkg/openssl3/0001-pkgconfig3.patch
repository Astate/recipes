From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Mon, 28 Sep 2026 12:53:04 -0500
Subject: [PATCH] pkgconfig3

---
 build.info                           | 16 ++++++++--------
 exporters/build.info                 | 16 ++++++++--------
 exporters/pkg-config/libcrypto.pc.in |  4 ++--
 exporters/pkg-config/libssl.pc.in    |  6 +++---
 exporters/pkg-config/openssl.pc.in   |  4 ++--
 5 files changed, 23 insertions(+), 23 deletions(-)

diff --git a/build.info b/build.info
index 4fb2cf5222..b6f58cb9b7 100644
--- a/build.info
+++ b/build.info
@@ -394,13 +394,13 @@ DEPEND[""]=OpenSSLConfigVersion.cmake
 # To achieve this, their variables are taken from builddata.pm.
 # These files are not installed; you will find the installable
 # versions in the 'exporters' directory.
-GENERATE[libcrypto.pc]=exporters/pkg-config/libcrypto.pc.in
-DEPEND[libcrypto.pc]=builddata.pm
-GENERATE[libssl.pc]=exporters/pkg-config/libssl.pc.in
-DEPEND[libssl.pc]=builddata.pm
-GENERATE[openssl.pc]=exporters/pkg-config/openssl.pc.in
-DEPEND[openssl.pc]=builddata.pm
-DEPEND[openssl.pc]=libcrypto.pc libssl.pc
+GENERATE[libcrypto3.pc]=exporters/pkg-config/libcrypto.pc.in
+DEPEND[libcrypto3.pc]=builddata.pm
+GENERATE[libssl3.pc]=exporters/pkg-config/libssl.pc.in
+DEPEND[libssl3.pc]=builddata.pm
+GENERATE[openssl3.pc]=exporters/pkg-config/openssl.pc.in
+DEPEND[openssl3.pc]=builddata.pm
+DEPEND[openssl3.pc]=libcrypto3.pc libssl3.pc
 
 GENERATE[builddata.pm]=util/mkinstallvars.pl \
     COMMENT="This file should be used when building against this OpenSSL build, and should never be installed" \
@@ -409,4 +409,4 @@ GENERATE[builddata.pm]=util/mkinstallvars.pl \
     ENGINESDIR=engines MODULESDIR=providers \
     "VERSION=$(VERSION)" "LDLIBS=$(LIB_EX_LIBS)"
 
-DEPEND[""]=openssl.pc
+DEPEND[""]=openssl3.pc
diff --git a/exporters/build.info b/exporters/build.info
index 9241dc9b0a..8ae094182b 100644
--- a/exporters/build.info
+++ b/exporters/build.info
@@ -8,15 +8,15 @@ DEPEND[OpenSSLConfigVersion.cmake]=OpenSSLConfig.cmake
 DEPEND[""]=OpenSSLConfigVersion.cmake
 
 # For installation: libcrypto.pc, libssl.pc, and openssl.pc
-GENERATE[libcrypto.pc]{exporter=pkg-config}=pkg-config/libcrypto.pc.in
-DEPEND[libcrypto.pc]=../installdata.pm
-GENERATE[libssl.pc]{exporter=pkg-config}=pkg-config/libssl.pc.in
-DEPEND[libssl.pc]=../installdata.pm
-GENERATE[openssl.pc]{exporter=pkg-config}=pkg-config/openssl.pc.in
-DEPEND[openssl.pc]=../installdata.pm
-DEPEND[openssl.pc]=libcrypto.pc libssl.pc
+GENERATE[libcrypto3.pc]{exporter=pkg-config}=pkg-config/libcrypto.pc.in
+DEPEND[libcrypto3.pc]=../installdata.pm
+GENERATE[libssl3.pc]{exporter=pkg-config}=pkg-config/libssl.pc.in
+DEPEND[libssl3.pc]=../installdata.pm
+GENERATE[openssl3.pc]{exporter=pkg-config}=pkg-config/openssl.pc.in
+DEPEND[openssl3.pc]=../installdata.pm
+DEPEND[openssl3.pc]=libcrypto3.pc libssl3.pc
 
-DEPEND[""]=openssl.pc
+DEPEND[""]=openssl3.pc
 
 GENERATE[../installdata.pm]=../util/mkinstallvars.pl \
     "PREFIX=$(INSTALLTOP)" BINDIR=bin "LIBDIR=$(LIBDIR)" "libdir=$(libdir)" \
diff --git a/exporters/pkg-config/libcrypto.pc.in b/exporters/pkg-config/libcrypto.pc.in
index eb6adffa91..87aec11b3b 100644
--- a/exporters/pkg-config/libcrypto.pc.in
+++ b/exporters/pkg-config/libcrypto.pc.in
@@ -15,10 +15,10 @@ includedir={- $OUT = '';
 enginesdir=${libdir}/{- $OpenSSL::safe::installdata::ENGINESDIR_REL_LIBDIR[0] -}
 modulesdir=${libdir}/{- $OpenSSL::safe::installdata::MODULESDIR_REL_LIBDIR[0] -}
 
-Name: OpenSSL-libcrypto
+Name: OpenSSL-libcrypto3
 Description: OpenSSL cryptography library
 Version: {- $OpenSSL::safe::installdata::VERSION -}
-Libs: -L${libdir} -lcrypto
+Libs: -L${libdir} -lcrypto-o3
 Libs.private: {- join(' ', @OpenSSL::safe::installdata::LDLIBS) -}
 Cflags:{- $OUT = ' -I${includedir}';
           if (scalar @OpenSSL::safe::installdata::INCLUDEDIR_REL_PREFIX > 1) {
diff --git a/exporters/pkg-config/libssl.pc.in b/exporters/pkg-config/libssl.pc.in
index 53228dde4a..d9e8e4299c 100644
--- a/exporters/pkg-config/libssl.pc.in
+++ b/exporters/pkg-config/libssl.pc.in
@@ -13,11 +13,11 @@ includedir={- $OUT = '';
               $OUT .= '${prefix}/' . $_ . ' '
                   foreach (@OpenSSL::safe::installdata::INCLUDEDIR_REL_PREFIX); -}
 
-Name: OpenSSL-libssl
+Name: OpenSSL-libssl3
 Description: Secure Sockets Layer and cryptography libraries
 Version: {- $OpenSSL::safe::installdata::VERSION -}
-Requires.private: libcrypto
-Libs: -L${libdir} -lssl
+Requires.private: libcrypto3
+Libs: -L${libdir} -lssl-o3
 Cflags:{- $OUT = ' -I${includedir}';
           if (scalar @OpenSSL::safe::installdata::INCLUDEDIR_REL_PREFIX > 1) {
               $OUT = '';
diff --git a/exporters/pkg-config/openssl.pc.in b/exporters/pkg-config/openssl.pc.in
index fd3bc9ac86..8806a43ad5 100644
--- a/exporters/pkg-config/openssl.pc.in
+++ b/exporters/pkg-config/openssl.pc.in
@@ -13,7 +13,7 @@ includedir={- $OUT = '';
               $OUT .= '${prefix}/' . $_ . ' '
                   foreach (@OpenSSL::safe::installdata::INCLUDEDIR_REL_PREFIX); -}
 
-Name: OpenSSL
+Name: OpenSSL3
 Description: Secure Sockets Layer and cryptography libraries and tools
 Version: {- $OpenSSL::safe::installdata::VERSION -}
-Requires: libssl libcrypto
+Requires: libssl3 libcrypto3

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Mon, 28 Sep 2026 21:54:40 -0500
Subject: [PATCH] ftbfs openssl 4

The openssl crate before 0.10.81 does not support OpenSSL 4.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-10-26
---
 Cargo.lock | 11 ++--
 Cargo.toml | 2 +-
 2 files changed, 5 insertions(+), 6 deletions(-)

--- a/Cargo.lock
+++ b/Cargo.lock
@@ -2616,15 +2616,14 @@
 
 [[package]]
 name = "openssl"
-version = "0.10.75"
+version = "0.10.81"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "08838db121398ad17ab8531ce9de97b244589089e290a384c900cb9ff7434328"
+checksum = "77823a27f0babb03091cb9ed9ef80af3b39dbc82f97e8fa530374b7dafd87a45"
 dependencies = [
  "bitflags 2.13.1",
  "cfg-if 1.0.4",
  "foreign-types",
  "libc",
- "once_cell",
  "openssl-macros",
  "openssl-sys",
 ]
@@ -2663,9 +2662,9 @@
 
 [[package]]
 name = "openssl-sys"
-version = "0.9.111"
+version = "0.9.117"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "82cab2d520aa75e3c58898289429321eb788c3106963d0dc886ec7a5f4adc321"
+checksum = "b47e7e6bb2c38cd930d25a23b40fa52e068c10e85f3e03a7f5ba5aaca5713695"
 dependencies = [
  "cc",
  "libc",
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -83,7 +83,7 @@
 opendal = { version = "0.58.1", optional = true, default-features = false }
 opendal-http-transport-reqwest = { version = "0.58.1", optional = true }
 opendal-layer-logging = { version = "0.58.1", optional = true }
-openssl = { version = "0.10.75", optional = true }
+openssl = { version = "0.10.81", optional = true }
 rand = "0.8.4"
 regex = "1.10.3"
 reqwest = { version = "0.13", features = [
